{
  "expo": {
    "name": "SkinAI Diagnostics",
    "slug": "shameer-burney",
    "owner": "sburneys-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0e14",
    "extra": {
      "eas": {
        "projectId": "8fbc1663-09d3-4af4-8293-67f7cf4add8c"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SkinAI to access your camera to analyze your skin."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SkinAI to access your photos to select an image for skin analysis."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sburney.skinaidiagnostics"
    },
    "android": {
      "package": "com.sburney.skinaidiagnostics",
      "adaptiveIcon": {
        "backgroundColor": "#0c0e14"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
